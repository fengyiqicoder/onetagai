{
  "name": "svelte-onetag",
  "version": "0.1.1",
  "description": "Svelte component that adds an Ask AI box to your site. It answers from your own pages, with no backend. Pairs with static-llms-txt for llms.txt on SvelteKit static sites.",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "package": "svelte-package && publint",
    "prepack": "npm run package",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "svelte-component",
    "svelte5",
    "llms.txt",
    "ai",
    "ask-ai",
    "chatbot",
    "search",
    "static-site",
    "onetag"
  ],
  "license": "MIT",
  "author": "OneTag AI (https://onetagai.com)",
  "homepage": "https://onetagai.com/?ref=svelte-onetag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengyiqicoder/onetagai.git",
    "directory": "packages/svelte-onetag"
  },
  "bugs": "https://github.com/fengyiqicoder/onetagai/issues",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "publint": "^0.3.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0"
  }
}
