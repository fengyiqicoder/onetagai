{
  "name": "astro-onetag",
  "version": "0.1.0",
  "description": "An Ask AI box for Astro sites: visitors ask, the answer is written from your page or your whole site. Static output, no backend, no API key in your code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./AskAI.astro": "./AskAI.astro"
  },
  "files": ["index.js", "index.d.ts", "AskAI.astro", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": ["astro-component", "withastro", "astro", "ui", "ai", "ask-ai", "chatbot", "search", "static-site", "no-backend", "pagefind", "onetag"],
  "license": "MIT",
  "author": "OneTag AI (https://onetagai.com)",
  "homepage": "https://onetagai.com/?ref=astro-onetag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengyiqicoder/onetagai.git",
    "directory": "packages/astro-onetag"
  },
  "bugs": "https://github.com/fengyiqicoder/onetagai/issues",
  "dependencies": {
    "onetagai": "^1.2.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  }
}
